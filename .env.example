# Copy to backend/.env and fill in. Never commit the real file.
DATABASE_URL=postgresql://getajob:getajob@localhost:5432/getajob

# Gemini (Google AI Studio, free tier). Leave GEMINI_API_KEY empty to run fully offline.
GEMINI_API_KEY=
LLM_MODEL=
EMBED_MODEL=
EMBED_DIM=768
# Your real per-model free-tier limits from AI Studio. Unset => conservative defaults (5 RPM / 100 RPD).
LLM_RPM=
LLM_RPD=
EMBED_RPM=
EMBED_RPD=

# 1 = canned LLM responses, no network calls
MOCK_LLM=0
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
EMBED_TPM=24000
EMBED_RESERVE_RPD=250
MAX_ACTIVE_JOBS=1000
HTTP_SLEEP_S=1.0